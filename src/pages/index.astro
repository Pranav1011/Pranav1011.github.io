---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import SectionHead from '../components/SectionHead.astro';
import WorkRow from '../components/WorkRow.astro';
import AlsoBuilt from '../components/AlsoBuilt.astro';
import Sections from '../components/Sections.astro';
import Contact from '../components/Contact.astro';
import { getFeatured, getSite } from '../lib/content';

const site = await getSite();
const featured = await getFeatured();
---

<BaseLayout title={`${site.name}, AI engineer`} description={site.description}>
  <main id="main">
    <Hero />

    <section class="band band--tint" aria-labelledby="work">
      <div class="container">
        <SectionHead id="work" title="Selected work" />
        {featured.map((project) => <WorkRow project={project} />)}
        <AlsoBuilt />
      </div>
    </section>

    <Sections />
    <Contact />
  </main>
</BaseLayout>

<style>
  .band--tint {
    --c-rule: var(--c-rule-on-tint);
    --hairline: 1px solid var(--c-rule-on-tint);
    background: var(--c-accent-tint);
    padding-block: var(--s-section) var(--s-section-lg);
  }
</style>
