---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import SectionHead from '../components/SectionHead.astro';
import WorkRow from '../components/WorkRow.astro';
import Sections from '../components/Sections.astro';
import Contact from '../components/Contact.astro';
import { getFeatured, getSite } from '../lib/content';

const site = await getSite();
const featured = await getFeatured();
---

<BaseLayout title={`${site.name}, AI engineer`} description={site.description}>
  <main id="main">
    <Hero />

    <section class="container work" aria-labelledby="work">
      <SectionHead id="work" title="Selected work" />
      {featured.map((project) => <WorkRow project={project} />)}
    </section>

    <Sections />
    <Contact />
  </main>
</BaseLayout>

<style>
  .work {
    margin-top: var(--s-16);
  }
</style>
