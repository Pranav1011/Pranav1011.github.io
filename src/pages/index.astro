---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import SectionHead from '../components/SectionHead.astro';
import WorkRow from '../components/WorkRow.astro';
import AlsoBuilt from '../components/AlsoBuilt.astro';
import Sections from '../components/Sections.astro';
import Contact from '../components/Contact.astro';
import Statement from '../components/Statement.astro';
import FocusList from '../components/FocusList.astro';
import Marquee from '../components/Marquee.astro';
import { getFeatured, getSite } from '../lib/content';

const site = await getSite();
const featured = await getFeatured();
---

<BaseLayout title={`${site.name}, AI engineer`} description={site.description}>
  <main id="main">
    <Hero />
    {/* Shown by motion/scroll-cue.ts only when motion is allowed and the page is at the top;
        a real link, so it works from the keyboard and reads as "Scroll to see more". */}
    <a class="scroll-cue" href="#work" data-scroll-cue hidden><span class="scroll-cue__text">Scroll to explore</span><svg class="scroll-cue__arrow" viewBox="0 0 16 30" aria-hidden="true"><path d="M8 1v26M2 21l6 7 6-7" /></svg></a>
    <FocusList />
    <Statement />
    <Marquee />

    <section class="band band--work scheme-work" aria-labelledby="work">
      <div class="container">
        <SectionHead id="work" title="Selected work" ruler={false} />
        <div class="stack">
          {featured.map((project, i) => <WorkRow project={project} index={i} />)}
        </div>
        <AlsoBuilt />
      </div>
    </section>

    <Sections />
  </main>
  <Contact slot="curtain" />
</BaseLayout>

<style>
  /* Selected work: paper, with each project on its own colour card. overflow-x: clip
     keeps the Aurora video inside the page while it's full-screen (clip, unlike hidden,
     leaves position: sticky working). */
  .band {
    padding-block: var(--s-12) var(--s-section);
    overflow-x: clip;
  }

  /* Scroll cue. From 1360px: centred at the bottom of the first screen, where the hero
     leaves that spot clear. Narrower: bottom right, on a paper backing so it stays
     readable over the intro. The arrow bobs only when motion is allowed. */
  .scroll-cue {
    position: fixed;
    z-index: 20;
    right: calc(var(--grid-margin) + env(safe-area-inset-right, 0px));
    bottom: calc(var(--s-6) + env(safe-area-inset-bottom, 0px));
    display: inline-flex;
    flex-direction: column;
    align-items: center;
    gap: var(--s-1);
    min-height: 44px;
    padding: var(--s-2) var(--s-3);
    border-radius: 12px;
    border: 1px solid var(--c-rule);
    background: var(--c-ground);
    color: var(--c-secondary);
    font-size: var(--t-small);
    font-weight: 560;
    text-decoration: none;
    transition: opacity 0.4s var(--ease-out);
  }

  @media (min-width: 1360px) {
    .scroll-cue {
      right: auto;
      left: 50%;
      transform: translateX(-50%);
      border: 0;
      background: none;
    }
  }

  .scroll-cue:hover,
  .scroll-cue:focus-visible {
    color: var(--c-accent);
  }

  .scroll-cue__arrow {
    width: 12px;
    height: 24px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.4;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  @media (prefers-reduced-motion: no-preference) {
    .scroll-cue__arrow {
      animation: cue-bob 2.4s ease-in-out infinite;
    }
  }

  @keyframes cue-bob {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(6px); }
  }

  .scroll-cue[data-leaving] {
    opacity: 0;
  }

  .scroll-cue[hidden] {
    display: none;
  }

  /* Cards sit inset in the petrol band, with the band showing on every side. */
  .stack {
    margin-top: var(--s-8);
    padding-inline: clamp(0rem, 2vw, 2.5rem);
  }

  /* Much larger than the other section titles: Selected work is the page's set piece. */
  .band :global(#work) {
    margin-top: 0;
    font-size: clamp(3rem, 1.6rem + 6.2vw, 8.5rem);
    line-height: 0.95;
    letter-spacing: -0.045em;
  }
</style>
