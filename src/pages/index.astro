---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import SectionHead from '../components/SectionHead.astro';
import WorkRow from '../components/WorkRow.astro';
import AlsoBuilt from '../components/AlsoBuilt.astro';
import Sections from '../components/Sections.astro';
import Contact from '../components/Contact.astro';
import { getFeatured, getSite } from '../lib/content';

const site = await getSite();
const featured = await getFeatured();
---

<BaseLayout title={`${site.name}, AI engineer`} description={site.description}>
  <main id="main">
    <Hero />

    <section class="band scheme-work" aria-labelledby="work">
      <div class="container">
        <SectionHead id="work" title="Selected work" ruler={false} />
        <div class="stack">
          {featured.map((project) => <WorkRow project={project} />)}
        </div>
        <AlsoBuilt />
      </div>
    </section>

    <Sections />
    <Contact />
  </main>
</BaseLayout>

<style>
  /* The band's colour marks the start, so it opens with the heading, not a gap. */
  .band {
    padding-block: var(--s-12) var(--s-section-lg);
  }

  .band :global(#work) {
    margin-top: 0;
  }
</style>
