---
// Source for public/og.png (1200×630). Not linked anywhere and excluded from the sitemap.
// Regenerate: build, preview, open /og-card/ at a 1200×630 viewport, screenshot to public/og.png.
// Uses the portrait (src/assets/photo.*) when present; until then, the Aurora trace.
import { Picture } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import TraceFigure from '../components/TraceFigure.astro';
import { getSite } from '../lib/content';
import { photo, PHOTO_ALT } from '../lib/photo';

const site = await getSite();
---

<BaseLayout title="Share card" description={site.description} noindex chrome={false}>
  <main class:list={['card', { 'card--photo': photo }]}>
    <div class="card__text">
      <p class="card__name">{site.name}</p>
      <h1>{site.headline}</h1>
      <p class="card__url">pranav1011.github.io</p>
    </div>
    {
      photo ? (
        <div class="card__photo">
          <Picture src={photo} alt={PHOTO_ALT} formats={['webp']} width={400} height={560} densities={[1]} loading="eager" />
        </div>
      ) : (
        <div class="card__figure"><TraceFigure idPrefix="og" /></div>
      )
    }
  </main>
</BaseLayout>

<style>
  .card {
    width: 1200px;
    height: 630px;
    padding: 64px 72px 56px;
    display: grid;
    grid-template-rows: auto 1fr;
    overflow: hidden;
  }

  .card--photo {
    grid-template-columns: 1fr 400px;
    grid-template-rows: 1fr;
    column-gap: 64px;
    padding: 65px 72px 65px 72px;
  }

  .card__text {
    display: flex;
    flex-direction: column;
  }

  .card--photo .card__text {
    justify-content: space-between;
  }

  .card__name {
    font-size: 26px;
    font-weight: 600;
  }

  h1 {
    margin-top: 20px;
    font-size: 64px;
    line-height: 1;
    letter-spacing: -0.035em;
    font-weight: 620;
    max-width: 18ch;
  }

  .card--photo h1 {
    font-size: 72px;
  }

  /* The same tall oval as the hero; the pre-cropped image has 6% spare above and below. */
  .card__photo {
    position: relative;
    width: 400px;
    height: 500px;
    border-radius: 50%;
    overflow: hidden;
  }

  .card__photo :global(img) {
    position: absolute;
    left: 0;
    top: -6%;
    width: 100%;
    height: 112%;
    object-fit: cover;
  }

  .card__figure {
    margin-top: 28px;
    align-self: end;
  }

  .card__figure :global(figcaption),
  .card__figure :global(.trace__head) {
    display: none;
  }

  .card__url {
    margin-top: 12px;
    font-size: 20px;
    color: var(--c-secondary);
  }
</style>
