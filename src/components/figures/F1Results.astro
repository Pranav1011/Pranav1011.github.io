---
import Figure from '../Figure.astro';
import BeforeAfter from '../charts/BeforeAfter.astro';
import data from '../../assets/projects/f1-ria/data.json';
interface Props { n: number; compact?: boolean; bare?: boolean }
const { n, compact = false, bare = false } = Astro.props;
const metrics = [
  { label: 'Tools', before: data.tools.before, after: data.tools.after, unit: 'tools' },
  { label: 'Size of the tool definitions', before: data.schema_tokens.before, after: data.schema_tokens.after, unit: 'tokens' },
];
const summary = `Tools: ${data.tools.before} before, ${data.tools.after} after. Tool-definition size: ${data.schema_tokens.before} tokens before, ${data.schema_tokens.after} after, a ${data.reduction_pct.tokens}% cut.`;
---

{
  bare ? (
    <BeforeAfter metrics={metrics} summary={summary} compact={compact} />
  ) : (
    <Figure
      n={n}
      caption={`Before and after consolidating the TimescaleDB tool surface. Both sets are measured the same way: ${data.method}.`}
      source="backend/eval/results/consolidation.json"
    >
      <BeforeAfter metrics={metrics} summary={summary} />
    </Figure>
  )
}
