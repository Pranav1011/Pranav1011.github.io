---
import Figure from '../Figure.astro';
import Dumbbell from '../charts/Dumbbell.astro';
import data from '../../assets/projects/aurora/data.json';
interface Props { n: number }

const mock = data.comparison.find((r) => r.brain === 'mock');
const rep = data.llama_repeat;
if (!mock || !rep) throw new Error('aurora data.json: needs the mock comparison row and llama_repeat');
const pct = (k: number, n: number) => (k / n) * 100;
const cleanRuns = rep.ticket_runs - rep.forbidden_action_ticket_runs;
const rows = [
  {
    label: 'Scripted stand-in',
    sub: `rules, no AI model; ${mock.n} tickets`,
    points: [
      { value: mock.task_success, label: 'Handled correctly', tone: 'brass' as const },
      { value: mock.action_safety, label: 'No forbidden actions', tone: 'accent' as const },
    ],
  },
  {
    label: 'Llama 3.1 8B',
    sub: `a real, smaller AI model; ${rep.runs} runs of ${rep.tickets_per_run} tickets`,
    points: [
      {
        lo: pct(rep.handled_min, rep.tickets_per_run),
        value: pct(rep.handled_max, rep.tickets_per_run),
        label: 'Handled correctly',
        tone: 'brass' as const,
        text: `Handled ${rep.handled_min}–${rep.handled_max} of ${rep.tickets_per_run} per run`,
      },
      {
        value: pct(cleanRuns, rep.ticket_runs),
        label: 'No forbidden actions',
        tone: 'accent' as const,
        text: `No forbidden action in ${cleanRuns} of ${rep.ticket_runs} runs`,
      },
    ],
  },
];
const bad = rep.forbidden_action_ticket_runs;
const title =
  bad === 0
    ? 'Swapped in a weaker AI model: it got worse at the job, but never took an action it wasn’t allowed to.'
    : `Swapped in a weaker AI model: it got worse at the job, and made ${bad} forbidden ${bad === 1 ? 'refund' : 'actions'} in ${rep.ticket_runs} runs.`;
const summary =
  `Scripted stand-in: handled ${mock.task_success}% correctly, no forbidden actions. ` +
  `Llama 3.1 8B over ${rep.runs} runs: handled ${rep.handled_min} to ${rep.handled_max} of ${rep.tickets_per_run} per run, ` +
  `a forbidden action in ${bad} of ${rep.ticket_runs} ticket runs.`;
---

<Figure
  n={Astro.props.n}
  title={title}
  caption={`The same ${rep.tickets_per_run} test tickets, the same agent, tools and safety checks; only the model doing the reasoning changes. Llama 3.1 8B was run ${rep.runs} times on the current code and varies from run to run: it handled ${rep.handled_min}–${rep.handled_max} of ${rep.tickets_per_run} correctly per run, took a forbidden action in ${bad} of ${rep.ticket_runs} ticket runs, and ${rep.reply_scope_violations_total === 0 ? 'put no other customer’s data in any reply' : `put another customer’s data in ${rep.reply_scope_violations_total} replies`}.`}
  source="docs/model-comparison.md (make compare) and docs/model-comparison-repeat.json (make compare-repeat)"
>
  <Dumbbell
    rows={rows}
    domain={[0, 100]}
    ticks={[0, 25, 50, 75, 100]}
    format="pct"
    summary={`${summary}.`}
  />
</Figure>
