---
import Figure from '../Figure.astro';
import Dumbbell from '../charts/Dumbbell.astro';
import data from '../../assets/projects/aurora/data.json';
interface Props { n: number }

const names: Record<string, { label: string; sub: string }> = {
  mock: { label: 'Deterministic mock', sub: 'rules, reproducible' },
  ollama: { label: 'Llama 3.1 8B', sub: 'local, via Ollama' },
};
const rows = data.comparison.map((r) => ({
  label: names[r.brain]?.label ?? r.brain,
  sub: names[r.brain]?.sub,
  points: [
    { value: r.task_success, label: 'Task success', tone: 'brass' as const },
    { value: r.action_safety, label: 'Action safety', tone: 'accent' as const },
  ],
}));
const slice = data.comparison[0].n;
const llama = data.comparison.find((r) => r.brain === 'ollama');
if (!llama) throw new Error('aurora data.json: no "ollama" row in comparison');
const summary = data.comparison
  .map((r) => `${names[r.brain]?.label ?? r.brain}: task success ${r.task_success}%, action safety ${r.action_safety}%`)
  .join('. ');
---

<Figure
  n={Astro.props.n}
  caption={`Same ${slice}-scenario slice, same loop, tools and guardrails; only the reasoning model changes. On Llama 3.1 8B, task success fell to ${llama.task_success}% while action safety stayed at ${llama.action_safety}%.`}
  source="docs/model-comparison.md, generated by make compare"
>
  <Dumbbell
    rows={rows}
    domain={[0, 100]}
    ticks={[0, 25, 50, 75, 100]}
    format="pct"
    summary={`${summary}.`}
  />
</Figure>
