---
import Figure from '../Figure.astro';
import Dumbbell from '../charts/Dumbbell.astro';
import data from '../../assets/projects/aurora/data.json';
interface Props { n: number }

const names: Record<string, { label: string; sub: string }> = {
  mock: { label: 'Scripted stand-in', sub: 'rules, no AI model' },
  ollama: { label: 'Llama 3.1 8B', sub: 'a real, smaller AI model' },
};
const rows = data.comparison.map((r) => ({
  label: names[r.brain]?.label ?? r.brain,
  sub: names[r.brain]?.sub,
  points: [
    { value: r.task_success, label: 'Handled correctly', tone: 'brass' as const },
    { value: r.action_safety, label: 'No forbidden actions', tone: 'accent' as const },
  ],
}));
const llama = data.comparison.find((r) => r.brain === 'ollama');
if (!llama) throw new Error('aurora data.json: no "ollama" row in comparison');
const handled = Math.round((llama.task_success / 100) * llama.n);
const withinRules = Math.round((llama.action_safety / 100) * llama.n);
const title =
  withinRules === llama.n
    ? 'Swapped in a weaker AI model: it got worse at the job, but never took an action it wasn’t allowed to.'
    : 'Swapped in a weaker AI model: it got worse at the job, and took actions it wasn’t allowed to.';
const summary = data.comparison
  .map((r) => `${names[r.brain]?.label ?? r.brain}: handled correctly ${r.task_success}%, no forbidden actions in ${r.action_safety}%`)
  .join('. ');
---

<Figure
  n={Astro.props.n}
  title={title}
  caption={`The same ${llama.n} test tickets, the same agent, tools and safety checks; only the model doing the reasoning changes. Llama 3.1 8B handled ${handled} of ${llama.n} correctly and took no forbidden action on ${withinRules === llama.n ? `any of the ${llama.n}` : `${withinRules} of ${llama.n}`}.`}
  source="docs/model-comparison.md, generated by make compare"
>
  <Dumbbell
    rows={rows}
    domain={[0, 100]}
    ticks={[0, 25, 50, 75, 100]}
    format="pct"
    summary={`${summary}.`}
  />
</Figure>
