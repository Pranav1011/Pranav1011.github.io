---
import { Picture } from 'astro:assets';
import { getSite, getResumeHref } from '../lib/content';
import { photo, PHOTO_ALT } from '../lib/photo';

const s = await getSite();
const resume = await getResumeHref();
/** A 1px petrol outline 8px outside the oval. */
const RING = false;
---

<section class:list={['hero container', { 'hero--photo': photo }]} aria-labelledby="hero-title">
  <h1 id="hero-title">{s.headline}</h1>
  <div class="hero__text">
    <p class="hero__subline">{s.subline}</p>
    {s.intro.map((p) => <p class="hero__intro">{p}</p>)}
    <p class="hero__availability">
      <span class="hero__dot" aria-hidden="true"></span>{s.availability}
    </p>
    <ul class="hero__links">
      <li><a class="hero__primary" href="#work">See selected work</a></li>
      {resume && <li><a href={resume}>Resume</a></li>}
      <li><a href={s.github}>GitHub</a></li>
      <li><a href={s.linkedin}>LinkedIn</a></li>
      <li><a href={`mailto:${s.email}`}>Email</a></li>
    </ul>
  </div>

  {
    photo && (
      <div class:list={['hero__photo', { 'hero__photo--ring': RING }]} data-parallax>
        {/* src/assets/photo.jpg is pre-cropped: a 4:5 frame centred on the face, eyes on the
            upper third, plus 6% spare above and below for the parallax (960 × 1344).
            AVIF and WebP at 1× and 2× with explicit dimensions. */}
        <Picture
          src={photo}
          alt={PHOTO_ALT}
          formats={['avif', 'webp']}
          width={480}
          height={672}
          densities={[1, 2]}
          loading="eager"
          fetchpriority="high"
        />
      </div>
    )
  }

</section>

<style>
  .hero {
    display: grid;
    grid-template-columns: repeat(var(--grid-cols), minmax(0, 1fr));
    column-gap: var(--grid-gutter);
    padding-block: clamp(2.5rem, 1.5rem + 4vw, 5rem) var(--s-12);
  }

  h1,
  .hero__text,
  .hero__photo {
    grid-column: 1 / -1;
  }

  .hero--photo h1 {
    grid-row: 2;
  }

  h1 {
    font-size: var(--t-display);
    line-height: var(--lh-display);
    letter-spacing: -0.035em;
    font-weight: var(--w-display);
    max-width: 20ch;
  }

  .hero__subline {
    margin-top: var(--s-6);
    max-width: 34ch;
    font-size: clamp(1.25rem, 1.05rem + 0.9vw, 1.75rem);
    line-height: 1.3;
    font-weight: 560;
    letter-spacing: -0.012em;
    color: var(--c-secondary);
  }

  .hero__intro {
    margin-top: var(--s-6);
    max-width: 58ch;
    font-size: clamp(1.0625rem, 1rem + 0.3vw, 1.25rem);
    line-height: 1.55;
  }

  .hero__availability {
    margin-top: var(--s-4);
    color: var(--c-secondary);
    display: flex;
    align-items: baseline;
    gap: var(--s-2);
  }

  .hero__dot {
    flex: none;
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 50%;
    background: var(--c-accent);
    transform: translateY(-0.05em);
  }

  .hero__links {
    list-style: none;
    padding: 0;
    margin-top: var(--s-6);
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--s-3) var(--s-6);
  }

  .hero__links a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
  }

  /* Page-coloured text on an accent fill holds on every scheme (7.32 : 1 on paper). */
  .hero__primary {
    padding-inline: var(--s-4);
    background: var(--c-accent);
    color: var(--c-page);
    text-decoration: none;
    font-weight: 560;
  }

  .hero__primary:hover {
    background: var(--c-accent-hover);
    color: var(--c-page);
  }

  /* A tall oval: a 4:5 frame with a 50% radius. The image is 12% taller than the frame
     (6% spare above and below), so the parallax moves it inside the oval without showing
     an edge; the oval itself stays put. On mobile it sits above the headline, small
     enough that the headline stays in the first screen. */
  .hero__photo {
    position: relative;
    grid-row: 1;
    width: 8.5rem;
    aspect-ratio: 4 / 5;
    margin-bottom: var(--s-8);
    border-radius: 50%;
    overflow: hidden;
    background: var(--c-rule);
  }

  .hero__photo--ring {
    overflow: visible;
  }

  .hero__photo--ring::after {
    content: '';
    position: absolute;
    inset: -8px;
    border: 1px solid var(--c-accent);
    border-radius: 50%;
    pointer-events: none;
  }

  .hero__photo--ring :global(picture) {
    position: absolute;
    inset: 0;
    border-radius: 50%;
    overflow: hidden;
  }

  .hero__photo :global(img) {
    position: absolute;
    left: 0;
    top: -6%;
    width: 100%;
    height: 112%;
    object-fit: cover;
  }

  @media (min-width: 1024px) {
    .hero--photo h1,
    .hero--photo .hero__text {
      grid-column: 1 / 8;
    }

    .hero--photo h1 {
      grid-row: 1;
    }

    .hero--photo .hero__photo {
      grid-column: 9 / -1;
      grid-row: 1 / span 2;
      align-self: start;
      width: 100%;
      margin: var(--s-2) 0 0;
    }
  }
</style>
