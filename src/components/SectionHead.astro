---
import Ruler from './Ruler.astro';
// Section opener: a full-width hairline with ruler ticks at the column lines, then a
// plain sentence-case h2. The only section decoration on the site.
interface Props {
  id: string;
  title: string;
  /** "sm" for the record sections (Research, Toolkit, Education) so the page has a beat. */
  size?: 'lg' | 'sm';
  /** Off where the section's own colour already marks the start (Selected work). */
  ruler?: boolean;
}
const { id, title, size = 'lg', ruler = true } = Astro.props;
---

{ruler && <Ruler />}
<h2 id={id} class:list={['section-title', `section-title--${size}`]}>{title}</h2>

<style>

  .section-title {
    margin-top: var(--s-6);
    font-size: var(--t-h2);
    letter-spacing: -0.025em;
    scroll-margin-top: var(--s-24);
  }

  .section-title--sm {
    margin-top: var(--s-4);
    font-size: var(--t-h3);
    letter-spacing: -0.015em;
  }
</style>
