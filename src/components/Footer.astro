---
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container site-footer__inner">
    <p>Sai Pranav Krovvidi, Boston, MA. {year}.</p>
    <p>Built with Astro. <a href="https://github.com/Pranav1011/Pranav1011.github.io">Source on GitHub</a>.</p>
  </div>
</footer>

<style>
  /* Continues the closing ink band. */
  .site-footer {
    --focus-ring: 0 0 0 2px var(--c-ink), 0 0 0 4px var(--c-accent-on-dark);
    background: var(--c-ink);
    border-top: 1px solid var(--c-rule-on-dark);
    font-size: var(--t-small);
    color: var(--c-secondary-on-dark);
  }

  .site-footer a {
    color: var(--c-accent-on-dark);
  }

  .site-footer a:hover {
    color: var(--c-ground);
  }

  .site-footer__inner {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: var(--s-2) var(--s-8);
    padding-block: var(--s-8);
  }
</style>
