---
const year = new Date().getFullYear();
---

<footer class="site-footer scheme-ink">
  <div class="container site-footer__inner">
    <p>Sai Pranav Krovvidi, Boston, MA. {year}.</p>
    <p>Built with Astro. <a href="https://github.com/Pranav1011/Pranav1011.github.io">Source on GitHub</a>.</p>
  </div>
</footer>

<style>
  /* Continues the closing ink band (the ink scheme, tokens.css). */
  .site-footer {
    border-top: var(--hairline);
    font-size: var(--t-small);
  }

  .site-footer p {
    color: var(--c-secondary);
  }

  .site-footer a:hover {
    color: var(--c-accent-hover);
  }

  .site-footer__inner {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: var(--s-2) var(--s-8);
    padding-block: var(--s-8);
  }
</style>
