---
import type { CollectionEntry } from 'astro:content';
import Cover from './Cover.astro';

interface Props {
  project: CollectionEntry<'projects'>;
  /** Position in the deck: sets the card's colour and its pin offset. */
  index: number;
}
const { index } = Astro.props;
const p = Astro.props.project.data;
/** Each project is its own solid-colour card (schemes and contrast in tokens.css). */
const SCHEMES = ['scheme-work', 'scheme-ink', 'scheme-brass'] as const;
const scheme = SCHEMES[index % SCHEMES.length];
const caseStudy = `/work/${p.slug}/`;
const headingId = `work-${p.slug}`;
---

<article class:list={['work-row', scheme]} style={`--i:${index}`} aria-labelledby={headingId} data-panel>
  <div class="work-row__inner">
  <div class="work-row__head">
    <p class="work-row__meta"><span class="work-row__domain">{p.domain}</span><span class="work-row__year tnum">{p.year}</span></p>
    <h3 id={headingId}><a href={caseStudy}>{p.title}</a></h3>
    {
      p.metric && (
        <p class="work-row__readout">
          <span class="work-row__value">{p.metric.value}</span>
          <span class="work-row__unit">{p.metric.label}</span>
        </p>
      )
    }
  </div>

  <div class="work-row__cover">
    {index === 0 && <p class="work-row__cover-label">Aurora, live: an AI agent working through support tickets</p>}
    <Cover project={Astro.props.project} />
  </div>

  <div class="work-row__body">
    <p class="work-row__problem">{p.summary}</p>

    <dl class="work-row__mechanisms">
      {
        p.mechanisms.map((m) => (
          <div>
            <dt>{m.label}</dt>
            <dd>{m.detail}</dd>
          </div>
        ))
      }
    </dl>

    <p class="work-row__result"><strong>Result.</strong> {p.result}</p>
    <p class="work-row__stack">{p.stack.join(', ')}</p>

    <ul class="work-row__links">
      <li><a href={caseStudy}>Read the case study<span class="visually-hidden">: {p.title}</span></a></li>
      {p.links.repo && <li><a href={p.links.repo}>Source on GitHub<span class="visually-hidden">: {p.title}</span></a></li>}
      {p.links.demo && <li><a href={p.links.demo}>Live demo<span class="visually-hidden">: {p.title}</span></a></li>}
    </ul>
  </div>
  </div>
</article>

<style>
  /* A solid-colour card, inset in the petrol band (capped at 1200px, centred). The overlay
     darkens it when the next card covers it (motion/panels.ts sets --dim); it's night ink,
     so it darkens every card colour. A faint outline keeps the petrol card distinct from
     the petrol band. */
  .work-row {
    position: relative;
    max-width: 1200px;
    margin: 0 auto var(--s-8);
    border-radius: 12px;
    box-shadow: 0 0 0 1px rgb(241 242 240 / 0.14), 0 24px 60px -30px rgb(0 0 0 / 0.55);
  }

  .work-row.scheme-ink {
    --c-figure: #e6ca91; /* pale brass on ink, 10.87:1 */
  }

  .work-row::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
    background: var(--c-night);
    opacity: var(--dim, 0);
    pointer-events: none;
    z-index: 3;
  }

  /* Mobile: domain, name and figure; then the cover; then summary to links. */
  .work-row__inner {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    grid-template-areas: 'head' 'cover' 'body';
    padding: var(--s-6) clamp(1.25rem, 4vw, 2rem) var(--s-8);
  }

  .work-row__head {
    grid-area: head;
    margin-bottom: var(--s-6);
  }

  .work-row__meta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--s-4);
  }

  /* The domain label: a small ruled tag. */
  .work-row__domain {
    padding: 0.2em 0.65em;
    border: 1px solid var(--c-rule);
    border-radius: 999px;
    font-size: var(--t-small);
    font-weight: 560;
    color: var(--c-ink);
    white-space: nowrap;
  }

  .work-row__year {
    font-size: var(--t-small);
    color: var(--c-secondary);
  }

  /* The project name is the card heading. */
  h3 {
    margin-top: var(--s-4);
    font-size: clamp(2rem, 1.3rem + 2vw, 3.25rem);
    line-height: 1;
    letter-spacing: -0.035em;
    font-weight: var(--w-display);
  }

  h3 a {
    color: var(--c-ink);
    text-decoration: none;
  }

  h3 a:hover,
  h3 a:focus-visible {
    color: var(--c-accent);
    text-decoration: underline;
    text-decoration-thickness: 3px;
    text-underline-offset: 0.12em;
  }

  .work-row__readout {
    margin-top: var(--s-4);
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: var(--s-1) var(--s-3);
  }

  .work-row__value {
    font-variant-numeric: proportional-nums;
    font-size: clamp(2.25rem, 1.6rem + 1.8vw, 3.25rem);
    line-height: 1;
    font-weight: 640;
    letter-spacing: -0.02em;
    color: var(--c-figure);
    white-space: nowrap;
  }

  .work-row__unit {
    font-size: var(--t-small);
    color: var(--c-secondary);
    max-width: 22ch;
  }

  .work-row__cover {
    grid-area: cover;
    position: relative;
    z-index: 2;
  }

  .work-row__cover :global(.cover) {
    border-radius: 12px;
  }

  .work-row__cover-label {
    margin-bottom: var(--s-2);
    font-size: var(--t-small);
    font-weight: 560;
    color: var(--c-secondary);
  }

  .work-row__body {
    grid-area: body;
  }

  .work-row__body > * {
    max-width: 50rem;
  }

  .work-row__problem {
    margin-top: var(--s-6);
  }

  .work-row__mechanisms {
    margin-top: var(--s-4);
    display: grid;
    gap: var(--s-3);
  }

  .work-row__mechanisms dt {
    font-size: var(--t-small);
    font-weight: 620;
  }

  .work-row__mechanisms dd {
    margin: var(--s-1) 0 0;
    font-size: var(--t-small);
    line-height: 1.45;
    color: var(--c-secondary);
  }

  .work-row__result {
    margin-top: var(--s-4);
    padding-top: var(--s-3);
    border-top: var(--hairline);
    font-size: var(--t-small);
    line-height: 1.5;
    font-weight: 500;
  }

  .work-row__result strong {
    font-weight: 640;
    color: var(--c-accent);
  }

  .work-row__stack {
    margin-top: var(--s-2);
    font-size: 0.8125rem;
    color: var(--c-secondary);
  }

  .work-row__links {
    list-style: none;
    padding: 0;
    margin-top: var(--s-2);
    display: flex;
    flex-wrap: wrap;
    gap: 0 var(--s-6);
  }

  .work-row__links a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    font-size: var(--t-small);
    font-weight: 500;
  }

  @media (min-width: 768px) and (max-width: 1023px) {
    .work-row__mechanisms {
      grid-template-columns: repeat(3, 1fr);
      column-gap: var(--grid-gutter);
    }
  }

  /* Desktop: cover on the left (about 60%); the text column on the right reads top to
     bottom: domain, name, key figure, then summary to links. Mechanisms show as labels
     only (the detail is in each case study). */
  @media (min-width: 1024px) {
    .work-row__inner {
      grid-template-columns: minmax(0, 1.55fr) minmax(0, 1fr);
      grid-template-areas: 'cover head' 'cover body';
      grid-template-rows: auto 1fr;
      column-gap: clamp(1.75rem, 1rem + 1.8vw, 3rem);
      align-items: start;
      padding: clamp(1.5rem, 0.5rem + 1.5vw, 2.25rem);
    }

    .work-row__head {
      margin-bottom: 0;
    }

    .work-row__cover {
      align-self: center;
    }

    .work-row__problem {
      margin-top: var(--s-4);
      font-size: var(--t-small);
      line-height: 1.5;
    }

    .work-row__mechanisms {
      display: flex;
      flex-wrap: wrap;
      gap: var(--s-1) var(--s-4);
    }

    .work-row__mechanisms dt {
      font-weight: 560;
      color: var(--c-secondary);
    }

    .work-row__mechanisms dt::before {
      content: '— ';
    }

    .work-row__mechanisms dd {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip-path: inset(50%);
      white-space: nowrap;
    }
  }

  /* The deck (motion allowed, every width; only once motion/panels.ts has run, which
     sets html.panels and --stick). Each card pins while the next slides up over it.
     Desktop: cards pin a little lower each time, so the previous card's top edge stays
     visible above the new one; the first card also holds for the Aurora video to shrink
     into place. A card taller than the screen (every card on a phone) pins by its
     bottom edge. CSS position: sticky with native scrolling; no scroll hijacking. */
  @media (prefers-reduced-motion: no-preference) {
    :global(html.panels) .work-row {
      position: sticky;
      top: var(--stick, 0px);
      transform-origin: 50% 0%;
    }

    :global(html.panels) .work-row:not(:first-child) {
      overflow-x: clip;
    }
  }

  @media (min-width: 1024px) and (prefers-reduced-motion: no-preference) {
    :global(html.panels) .work-row:first-child {
      margin-bottom: 110svh;
    }
  }
</style>
