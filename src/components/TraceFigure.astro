---
// The hero instrument: two real Aurora runs of the same ticket on the same model,
// drawn as a timing sheet. Data: src/data/aurora-trace.json (scripts/extract-aurora-trace.py).
import trace from '../data/aurora-trace.json';

interface Props {
  /** Adds an id prefix so the figure can appear twice on a page (e.g. the OG card). */
  idPrefix?: string;
}
const { idPrefix = 'trace' } = Astro.props;

type Ev = { t: number; type: string; phase: string; tool?: string; decision?: string; reason?: string };
type Run = { events: Ev[] };

function summarise(run: Run) {
  const ev = run.events;
  const find = (type: string) => {
    const e = ev.find((x) => x.type === type);
    if (!e) throw new Error(`aurora-trace.json: run is missing a "${type}" event`);
    return e;
  };
  const at = (type: string) => find(type).t;
  const loops = ev.filter((e) => e.type === 'tool_call' && e.tool === 'get_order').map((e) => e.t);
  if (loops.length === 0) throw new Error('aurora-trace.json: run has no get_order tool calls');
  const guard = find('guard');
  return { plan: at('plan'), firstAct: loops[0], loops, guard: guard.t, decision: guard.decision, reply: at('reply') };
}

const before = summarise(trace.before as Run);
const after = summarise(trace.after as Run);
/** Axis window: from just before the first tool call (the first ~20 s of reading the
 *  ticket and planning are cropped, and the caption says so) to just past the later reply. */
const T_MIN = Math.floor(Math.min(before.firstAct, after.firstAct) / 5) * 5 - 2;
const T_MAX = Math.ceil(Math.max(before.reply, after.reply) / 5) * 5 + 3;
const tickEvery = (step: number) => {
  const first = Math.ceil(T_MIN / step) * step;
  return Array.from({ length: Math.floor((T_MAX - first) / step) + 1 }, (_, i) => first + i * step);
};

/** Build one layout of the figure, each drawn near 1:1 for its breakpoint:
 *  wide ≥ 1024px, medium 640–1023px, compact < 640px. */
function layout(width: number, labelW: number, rowH: number, fs: number, stackReply = false) {
  const right = width - 8;
  const x = (t: number) => labelW + ((t - T_MIN) / (T_MAX - T_MIN)) * (right - labelW);
  const rows = [
    { key: 'before', run: before, label: ['Without', 'the check'], tone: 'brass' },
    { key: 'after', run: after, label: ['With', 'the check'], tone: 'accent' },
  ].map((r, i) => ({ ...r, y: 48 + i * rowH }));
  const ticks = tickEvery(width > 500 ? 10 : 20);
  const height = 48 + (rows.length - 1) * rowH + (stackReply ? 88 : 72);
  /** Place a label right of `at`; flip it left if it would cross the right edge; and if
   *  it fits neither side, right-align it to the chart edge. */
  const place = (at: number, text: string, gap = 10) => {
    const w = text.length * fs * 0.62;
    if (at + gap + w <= right) return { x: at + gap, anchor: 'start' };
    if (at - gap - w >= labelW * 0.5) return { x: at - gap, anchor: 'end' };
    return { x: right, anchor: 'end' };
  };
  return { width, height, x, rows, ticks, fs, place, replyDy: stackReply ? 28 + fs + 6 : 28 };
}

const wide = layout(1200, 176, 128, 16);
const medium = layout(720, 124, 124, 14, true);
const compact = layout(360, 86, 120, 12, true);
const fmt = (t: number) => `${t.toFixed(1)} s`;
---

<figure class="trace" aria-labelledby={`${idPrefix}-cap`} data-trace data-t-start={Math.min(before.firstAct, after.firstAct)} data-t-end={Math.max(before.reply, after.reply)}>
  <div class="trace__head">
    <p class="trace__title">Same ticket, same AI model. The only difference is a check that stops it repeating itself.</p>
    <button type="button" class="trace__replay" hidden>
      <svg viewBox="0 0 12 12" aria-hidden="true"><path d="M6 1.5a4.5 4.5 0 1 1-4.3 3.2" /><path d="M1.2 1.6v3.3h3.3" /></svg>
      Replay<span class="visually-hidden"> the two runs</span>
    </button>
  </div>
  {
    [
      { l: wide, cls: 'trace__svg trace__svg--wide' },
      { l: medium, cls: 'trace__svg trace__svg--medium' },
      { l: compact, cls: 'trace__svg trace__svg--compact' },
    ].map(({ l, cls }) => (
      <svg class={cls} viewBox={`0 0 ${l.width} ${l.height}`} role="img" aria-labelledby={`${idPrefix}-cap`}>
        {/* Time axis */}
        <g class="axis" font-size={l.fs}>
          {l.ticks.map((t) => (
            <g>
              <line x1={l.x(t)} x2={l.x(t)} y1={18} y2={l.height - 24} class="grid" />
              <text x={l.x(t)} y={l.height - 8} text-anchor="middle">{t === l.ticks[0] ? `${t} s` : t}</text>
            </g>
          ))}
        </g>

        {l.rows.map((row) => {
          const r = row.run;
          const y = row.y;
          const caught = row.key === 'after';
          return (
            <g class={`row row--${row.tone}`} font-size={l.fs} data-row={row.key}>
              <text x={0} y={y - 5} class="row__label">{row.label[0]}</text>
              <text x={0} y={y + l.fs + 4} class="row__label">{row.label[1]}</text>

              {/* Before the first tool call: reading the ticket and planning (cropped) */}
              <line x1={l.x(T_MIN)} x2={l.x(r.firstAct)} y1={y} y2={y} class="phase phase--quiet" />
              <line x1={l.x(r.firstAct)} x2={l.x(r.guard)} y1={y} y2={y} class="phase phase--act" data-t0={r.firstAct} data-t1={r.guard} />
              <line x1={l.x(r.guard)} x2={l.x(r.reply)} y1={y} y2={y} class="phase phase--quiet phase--post" data-t0={r.guard} data-t1={r.reply} />

              {/* Each get_order tool call */}
              {r.loops.map((t) => (
                <line x1={l.x(t)} x2={l.x(t)} y1={y - 15} y2={y + 15} class="call" data-t={t} />
              ))}

              {/* The guard that ended the act loop */}
              <rect
                x={l.x(r.guard) - 8}
                y={y - 8}
                width={16}
                height={16}
                class="guard"
                data-t={r.guard}
                transform={caught ? `rotate(45 ${l.x(r.guard)} ${y})` : undefined}
              />
              <circle cx={l.x(r.reply)} cy={y} r={6} class="reply" data-t={r.reply} />

              {(() => {
                const guardText = caught ? `caught repeating, ${fmt(r.guard)}` : `hit the step limit, ${fmt(r.guard)}`;
                const replyText = `handed to a human, ${fmt(r.reply)}`;
                const g = l.place(l.x(r.guard), guardText, 6);
                const rp = l.place(l.x(r.reply), replyText, 8);
                return (
                  <>
                    <text x={g.x} y={y - 22} text-anchor={g.anchor} class="note note--guard" data-t={r.guard}>{guardText}</text>
                    <text x={rp.x} y={y + l.replyDy} text-anchor={rp.anchor} class="note note--quiet note--reply" data-t={r.reply}>{replyText}</text>
                    <text x={l.x(r.firstAct)} y={y + 28} class="note note--quiet note--count" data-t={r.loops[r.loops.length - 1]}>{r.loops.length === 1 ? '1 lookup of the order' : `${r.loops.length} lookups of the same order`}</text>
                  </>
                );
              })()}
            </g>
          );
        })}
      </svg>
    ))
  }
  <figcaption id={`${idPrefix}-cap`}>
    {
      `Aurora handling a real test ticket (a customer charged twice) on Llama 3.1 8B, drawn from its run logs. ` +
        `Without the check, it looked up the same order ${before.loops.length} times until a hard step limit stopped it at ${fmt(before.guard)}. ` +
        `With the check, the repeat was caught at ${fmt(after.guard)}. Both runs ended with the ticket handed to a human. ` +
        `The first ${T_MIN} seconds, reading the ticket and planning, are cropped from the chart.`
    }
  </figcaption>
</figure>

<style>
  .trace {
    margin: 0;
  }

  .trace__svg {
    width: 100%;
    height: auto;
    overflow: visible;
    font-family: var(--f-mono);
  }

  .trace__svg--medium,
  .trace__svg--compact {
    display: none;
  }

  @media (max-width: 1023px) {
    .trace__svg--wide {
      display: none;
    }
    .trace__svg--medium {
      display: block;
    }
  }

  @media (max-width: 639px) {
    .trace__svg--medium {
      display: none;
    }
    .trace__svg--compact {
      display: block;
    }
  }

  .grid {
    stroke: var(--c-rule);
    stroke-width: 1;
  }

  .axis text {
    fill: var(--c-secondary);
  }

  .row__label {
    font-family: var(--f-sans);
    font-weight: 600;
    fill: var(--c-ink);
  }

  .phase {
    stroke-linecap: round;
  }

  .phase--quiet {
    stroke: var(--c-secondary);
    stroke-width: 2;
    stroke-dasharray: 2 5;
  }

  .phase--act {
    stroke-width: 5;
  }

  .row--brass .phase--act,
  .row--brass .call {
    stroke: var(--c-brass);
  }

  .row--accent .phase--act,
  .row--accent .call {
    stroke: var(--c-accent);
  }

  .call {
    stroke-width: 3;
  }

  .row--brass .guard {
    fill: var(--c-brass);
  }

  .row--accent .guard {
    fill: var(--c-accent);
  }

  .reply {
    fill: var(--c-ground);
    stroke: var(--c-ink);
    stroke-width: 2;
  }

  /* A ground-coloured halo keeps labels legible where they cross grid lines. */
  .note,
  .axis text {
    paint-order: stroke;
    stroke: var(--c-ground);
    stroke-width: 5px;
    stroke-linejoin: round;
  }

  .note {
    fill: var(--c-ink);
  }

  .row--brass .note:not(.note--quiet) {
    fill: var(--c-brass-text);
  }

  .row--accent .note:not(.note--quiet) {
    fill: var(--c-accent);
    font-weight: 500;
  }

  .note--quiet {
    fill: var(--c-secondary);
  }

  .trace__head {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: var(--s-6);
    margin-bottom: var(--s-8);
  }

  .trace__title {
    font-size: var(--t-h3);
    font-weight: 600;
    letter-spacing: -0.015em;
    line-height: 1.2;
    max-width: 36ch;
  }

  .trace__replay {
    flex: none;
    display: inline-flex;
    align-items: center;
    gap: var(--s-2);
    min-height: 44px;
    padding: 0 var(--s-4);
    border: 1px solid var(--c-ink);
    background: transparent;
    color: var(--c-ink);
    font: inherit;
    font-size: var(--t-small);
    font-weight: 600;
    cursor: pointer;
    transition:
      background-color var(--dur-fast) var(--ease-out),
      color var(--dur-fast) var(--ease-out);
  }

  .trace__replay[hidden] {
    display: none;
  }

  .trace__replay:hover {
    background: var(--c-ink);
    color: var(--c-ground);
  }

  .trace__replay svg {
    width: 12px;
    height: 12px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.6;
    stroke-linecap: round;
  }

  figcaption {
    margin-top: var(--s-6);
    max-width: 72ch;
    font-size: var(--t-meta);
    line-height: 1.55;
    color: var(--c-secondary);
  }

  figcaption code {
    font-family: var(--f-mono);
    font-size: 0.95em;
  }
</style>
