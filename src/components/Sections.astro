---
// Home-page sections after Selected work. One file keeps the shared two-column
// "label | content" rhythm in one place.
import SectionHead from './SectionHead.astro';
import { getExperience, getPublication, getSite, formatMonth } from '../lib/content';

const roles = await getExperience();
const pub = await getPublication();
const site = await getSite();
---

<section class="band band--experience scheme-brass" aria-labelledby="experience">
  <div class="container">
  <SectionHead id="experience" title="Experience" />
  <div class="timeline-wrap">
  <span class="timeline__line" aria-hidden="true"></span>
  <ol class="timeline">
    {
      roles.map((r) => (
        <li class="split">
          <p class="split__label tnum">
            <time datetime={r.start}>{formatMonth(r.start)}</time> – <time datetime={r.end}>{formatMonth(r.end)}</time>
          </p>
          <div class="split__content">
            <h3>
              {r.title}, {r.company}
            </h3>
            <p class="meta">{r.location}</p>
            <ul class="points">
              {r.points.map((pt) => <li>{pt}</li>)}
            </ul>
          </div>
        </li>
      ))
    }
  </ol>
  </div>
  </div>
</section>

<section class="band band--record" aria-labelledby="record">
  <div class="container">
  <SectionHead id="record" title="Research, toolkit and education" size="sm" />
  <div class="record">
    <div class="record__col">
      <section class="record__group" aria-labelledby="research">
        <h3 id="research" class="record__head">Research</h3>
        <p class="record__label tnum">{pub.year}</p>
        <p class="record__title"><a href={pub.url}>{pub.title}</a></p>
        <p class="meta">
          {pub.venue}, vol. {pub.volume}, pp. {pub.pages}. {pub.role}. DOI {pub.doi}
        </p>
      </section>

      <section class="record__group" aria-labelledby="education">
        <h3 id="education" class="record__head">Education</h3>
        <ul class="education">
          {
            site.education.map((e) => (
              <li>
                <p class="record__label tnum">{e.dates}</p>
                <p class="record__title">{e.degree}</p>
                <p class="meta">
                  {e.school}. {e.detail}
                </p>
              </li>
            ))
          }
        </ul>
      </section>
    </div>

    <section class="record__col record__group" aria-labelledby="toolkit">
      <h3 id="toolkit" class="record__head">Toolkit</h3>
      <dl class="toolkit">
        {
          site.toolkit.map((g) => (
            <div>
              <dt>{g.group}</dt>
              <dd>{g.items.join(', ')}</dd>
            </div>
          ))
        }
      </dl>
    </section>
  </div>
  </div>
</section>

<style>
  .band--experience {
    padding-block: var(--s-section) var(--s-section);
  }

  .band--record {
    padding-block: var(--s-section-sm) var(--s-section);
  }

  .split {
    display: grid;
    grid-template-columns: repeat(var(--grid-cols), minmax(0, 1fr));
    column-gap: var(--grid-gutter);
    padding-block: var(--s-6);
  }

  .split + .split {
    border-top: var(--hairline);
  }

  .split__label {
    grid-column: 1 / -1;
    font-size: var(--t-meta);
    color: var(--c-secondary);
    margin-bottom: var(--s-2);
  }

  .split__content {
    grid-column: 1 / -1;
  }

  @media (min-width: 768px) {
    .split__label {
      grid-column: 1 / 4;
      margin-bottom: 0;
      padding-top: 0.2em;
    }

    .split__content {
      grid-column: 4 / 12;
    }
  }

  ol,
  ul {
    list-style: none;
    padding: 0;
  }

  /* The rule on the left draws down as you scroll (motion/reveals.ts); static without JS. */
  .timeline-wrap {
    position: relative;
    margin-top: var(--s-8);
    padding-left: var(--s-6);
  }

  .timeline__line {
    position: absolute;
    left: 0;
    top: var(--s-6);
    bottom: var(--s-6);
    width: 2px;
    background: var(--c-accent);
  }

  .timeline > li {
    position: relative;
  }

  .timeline > li::before {
    content: '';
    position: absolute;
    left: calc(var(--s-6) * -1 - 4px);
    top: calc(var(--s-6) + 0.35em);
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: var(--c-page);
    border: 2px solid var(--c-accent);
  }

  /* Research, toolkit and education: one section, two columns at desktop. */
  .record {
    margin-top: var(--s-8);
    display: grid;
    gap: var(--s-12) var(--grid-gutter);
  }

  .record__col {
    display: grid;
    align-content: start;
    gap: var(--s-12);
  }

  .record__head {
    padding-bottom: var(--s-2);
    border-bottom: var(--hairline);
    font-size: var(--t-small);
    font-weight: 620;
    letter-spacing: 0.01em;
    scroll-margin-top: var(--s-24);
  }

  .record__label {
    margin-top: var(--s-4);
    font-size: var(--t-meta);
    color: var(--c-secondary);
  }

  .record__title {
    margin-top: var(--s-1);
    font-size: 1.0625rem;
    font-weight: 600;
    line-height: 1.35;
  }

  .record__title a {
    color: var(--c-ink);
    text-decoration-color: var(--c-rule);
    text-decoration-thickness: 2px;
  }

  .record__title a:hover {
    color: var(--c-accent);
  }

  .education {
    display: grid;
    gap: var(--s-2);
  }

  @media (min-width: 1024px) {
    .record {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      column-gap: clamp(2rem, 1rem + 2.5vw, 4rem);
    }
  }

  h3 {
    font-size: 1.125rem;
    font-weight: 600;
    letter-spacing: -0.01em;
    line-height: 1.3;
  }

  h3 a {
    color: var(--c-ink);
    text-decoration-color: var(--c-rule);
    text-decoration-thickness: 2px;
  }

  h3 a:hover {
    color: var(--c-accent);
  }

  .meta {
    margin-top: var(--s-1);
    font-size: var(--t-meta);
    color: var(--c-secondary);
  }

  .points {
    margin-top: var(--s-3);
    display: grid;
    gap: var(--s-2);
    max-width: 66ch;
  }

  .points li {
    padding-left: 1.1em;
    position: relative;
  }

  .points li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.7em;
    width: 0.45em;
    height: 1px;
    background: var(--c-secondary);
  }

  /* Toolkit */
  .toolkit {
    margin-top: var(--s-4);
    display: grid;
    gap: var(--s-4) var(--grid-gutter);
  }

  .toolkit dt {
    font-size: var(--t-small);
    font-weight: 600;
  }

  .toolkit dd {
    margin: var(--s-1) 0 0;
    color: var(--c-secondary);
  }

  @media (min-width: 768px) {
    .toolkit {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
</style>
