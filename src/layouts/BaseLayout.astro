---
import { Font } from 'astro:assets';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { getSite } from '../lib/content';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  /** Absolute or root-relative path to a 1200×630 share image. */
  image?: string;
  noindex?: boolean;
  /** Pages that render their own chrome (the OG card) turn this off. */
  chrome?: boolean;
}

const { title, description, image = '/og.png', noindex = false, chrome = true } = Astro.props;
const site = await getSite();
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL(image, Astro.site);

const person = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: site.name,
  jobTitle: 'AI Engineer',
  url: Astro.site?.href,
  email: `mailto:${site.email}`,
  address: { '@type': 'PostalAddress', addressLocality: 'Boston', addressRegion: 'MA', addressCountry: 'US' },
  alumniOf: site.education.map((e) => ({ '@type': 'CollegeOrUniversity', name: e.school })),
  sameAs: [site.github, site.linkedin],
};
---

<!doctype html>
<html lang="en" data-no-motion={chrome ? undefined : ""}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {/* Noindex pages (404, OG card) get no canonical: their URL is not a real page. */}
    {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonical} />}
    <meta name="theme-color" content="#f1f2f0" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32.png" type="image/png" sizes="32x32" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${site.name}: ${site.headline}`} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <script type="application/ld+json" set:html={JSON.stringify(person)} />

    {/* `js` scopes enhanced UI. `motion-pending` briefly hides only the hero headline until
        GSAP takes over; skipped under reduced motion, and a fail-safe clears it if the
        motion bundle never runs. Without JS nothing is hidden. */}
    <script is:inline>
      (function () {
        var r = document.documentElement;
        r.classList.add('js');
        if (!matchMedia('(prefers-reduced-motion: reduce)').matches) {
          r.classList.add('motion-pending');
          setTimeout(function () {
            if (r.classList.contains('motion-pending')) {
              r.classList.remove('motion-pending');
              r.dataset.motionFallback = '1';
            }
          }, 2500);
        }
      })();
    </script>

    <Font cssVariable="--font-sans" preload />
    <Font cssVariable="--font-mono" />
    <slot name="head" />
  </head>
  <body>
    {
      chrome && (
        <>
          <a class="skip-link" href="#main">Skip to content</a>
          <Header />
        </>
      )
    }
    <slot />
    {
      /* The home page passes its closing CTA as the "curtain": with the footer, it sits
         behind the page and is revealed as the content above lifts away (motion/curtain.ts). */
      Astro.slots.has('curtain') ? (
        <div class="curtain scheme-ink" data-curtain>
          <slot name="curtain" />
          {chrome && <Footer />}
          {/* Decorative: the name is already in the header and footer. */}
          <p class="wordmark" aria-hidden="true"><span class="wordmark__text">SAI PRANAV</span></p>
        </div>
      ) : (
        chrome && <Footer />
      )
    }
  </body>
</html>
{/* Motion bundle: Astro hoists and bundles this module script. The OG card (chrome=false)
    sets data-no-motion so it renders its final state for the screenshot. */}
<script>
  if (!document.documentElement.hasAttribute('data-no-motion')) import('../scripts/motion/index.ts');
</script>
